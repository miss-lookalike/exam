\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa200\sl276\slmult1 Production RSC 2006\par
{\pntext\f2\'B7\tab}Director: Rupert Goold\u8239? \par
{\pntext\f2\'B7\tab}Prospero \f1\endash  Patrick Stewart \par
